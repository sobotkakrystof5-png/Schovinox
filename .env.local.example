# Produkční doména — používá se pro canonical URL, sitemap, OG a rozpoznání
# preview/produkčního hostname (noindex mimo tuto doménu). Bez nastavení
# padá zpět na https://schovinox.cz, takže je bezpečné ho nechat prázdné
# i před připojením domény.
NEXT_PUBLIC_SITE_URL=https://schovinox.cz

# SMTP přes Seznam EmailProfi — mailbox na doméně schovinox.cz, přes který web odesílá poštu
# (stejné přihlašovací údaje jako do webmailu na schránka.seznam.cz)
SMTP_HOST=smtp.seznam.cz
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# E-mail, na který chodí poptávky z formulářů
CONTACT_EMAIL=nerez.schovanek@seznam.cz

# Odesílací adresa e-mailů (musí odpovídat schránce SMTP_USER výše; pokud prázdné, použije se SMTP_USER)
CONTACT_FROM_EMAIL=
