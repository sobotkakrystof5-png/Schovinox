# Produkční doména — používá se pro canonical URL, sitemap, OG a rozpoznání
# preview/produkčního hostname (noindex mimo tuto doménu). Bez nastavení
# padá zpět na https://schovinox.cz, takže je bezpečné ho nechat prázdné
# i před připojením domény.
NEXT_PUBLIC_SITE_URL=https://schovinox.cz

# Resend (https://resend.com) — API klíč pro odesílání e-mailů z kontaktního formuláře
RESEND_API_KEY=

# E-mail, na který chodí poptávky (výchozí: info@schovinox.cz)
CONTACT_EMAIL=info@schovinox.cz

# Odesílací adresa e-mailů (musí být ověřená doména v Resend, jinak použijte onboarding@resend.dev pro test)
CONTACT_FROM_EMAIL="Schovinox web <onboarding@resend.dev>"
