# Produkční doména — používá se pro canonical URL, sitemap, OG a rozpoznání
# preview/produkčního hostname (noindex mimo tuto doménu). Musí přesně
# odpovídat hostname, na kterém Vercel produkci servíruje (aktuálně www),
# jinak middleware.ts a robots.ts vyhodnotí produkci jako "cizí" hostname
# a pošlou noindex + Disallow: / na celý web.
NEXT_PUBLIC_SITE_URL=https://www.schovinox.cz

# Resend (https://resend.com) — API klíč pro odesílání e-mailů z formulářů
RESEND_API_KEY=

# E-mail, na který chodí poptávky z formulářů
CONTACT_EMAIL=nerez.schovanek@seznam.cz

# Odesílací adresa e-mailů (musí být na doméně ověřené v Resend, jinak nechte prázdné
# a použije se sdílená adresa onboarding@resend.dev — funguje, ale s horší důvěryhodností)
CONTACT_FROM_EMAIL="Schovinox web <poptavky@schovinox.cz>"
